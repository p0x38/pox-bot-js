{
  "name": "pox-bot",
  "version": "1.0.0",
  "description": "A weird discord bot.",
  "homepage": "https://github.com/p0x38/poxbot2#readme",
  "bugs": {
    "url": "https://github.com/p0x38/poxbot2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p0x38/poxbot2.git"
  },
  "license": "ISC",
  "author": "p0x38",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "db:init": "ts-node scripts/init-db.ts",
    "clean": "shx rm -rf dist",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "pnpm run clean && tsc && shx cp -r resources dist/ && shx cp config.json dist/",
    "start": "node dist/src/index.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "date-fns": "^4.1.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "i18next": "^26.0.8",
    "i18next-chained-backend": "^5.0.3",
    "i18next-fs-backend": "^2.6.5",
    "i18next-icu": "^2.4.3",
    "i18next-intervalplural-postprocessor": "^3.0.0",
    "iso-639-1": "^3.1.5",
    "pg": "^8.20.0",
    "winston": "^3.19.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
