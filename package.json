{
    "name": "pox-bot",
    "version": "1.0.1",
    "description": "A weird discord bot.",
    "homepage": "https://github.com/p0x38/poxbot2#readme",
    "bugs": {
        "url": "https://github.com/p0x38/poxbot2/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/p0x38/poxbot2.git"
    },
    "license": "ISC",
    "author": "p0x38",
    "type": "module",
    "main": "dist/index.js",
    "files": [
        "dist",
        "resources"
    ],
    "engines": {
        "node": ">=18.18"
    },
    "packageManager": "pnpm@9.0.0",
    "scripts": {
        "clean": "rimraf dist",
        "prebuild": "pnpm run lint",
        "build": "pnpm run clean && tsc --noEmit && tsup src/index.ts \"src/commands/**/*.ts\" \"src/events/**/*.ts\" --format esm --clean && shx cp -r src/assets dist/ && shx cp src/config.json dist/",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "typecheck": "tsc --noEmit",
        "ci:install": "pnpm install --frozen-lockfile",
        "ci:check": "pnpm run lint && pnpm run build",
        "ci": "pnpm run ci:install && pnpm run ci:check",
        "prepare": "husky",
        "release": "release-it"
    },
    "dependencies": {
        "@fluent/bundle": "^0.19.1",
        "@fluent/langneg": "^0.7.0",
        "chalk": "^5.6.2",
        "date-fns": "^4.1.0",
        "discord.js": "^14.26.3",
        "dotenv": "^17.4.2",
        "i18next": "^26.0.8",
        "i18next-chained-backend": "^5.0.3",
        "i18next-fs-backend": "^2.6.5",
        "i18next-icu": "^2.4.3",
        "i18next-intervalplural-postprocessor": "^3.0.0",
        "iso-639-1": "^3.1.5",
        "pg": "^8.20.0",
        "winston": "^3.19.0",
        "zod": "^4.4.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@eslint/js": "^10.0.1",
        "@release-it/conventional-changelog": "^11.0.0",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.20.0",
        "@typescript-eslint/eslint-plugin": "^8.59.1",
        "@typescript-eslint/parser": "^8.59.1",
        "chokidar": "^5.0.0",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "fast-glob": "^3.3.3",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.3",
        "release-it": "^20.0.1",
        "rimraf": "^6.1.3",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.17",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    }
}
