{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "declaration": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "noUncheckedIndexedAccess": true
    },
    "include": ["src/**/*", "config.json", ".release-it.ts"],
    "exclude": ["node_modules", "dist"]
}
